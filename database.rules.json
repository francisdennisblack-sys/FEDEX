{
  "rules": {

    "posts": {
      ".read": true,
      "$postId": {
        ".write": "auth != null"
      }
    },

    "posts_by_zone": {
      ".read": true,
      "$zone": {
        ".write": "auth != null"
      }
    },

    "post_events": {
      ".read": true,
      "$eventType": {
        "$postId": {
          ".write": "auth != null"
        }
      }
    },

    "post-votes": {
      ".read": true,
      "$postId": {
        ".write": "auth != null"
      }
    },

    "user-votes": {
      "$userId": {
        ".read":  "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "user-posts": {
      "$userId": {
        ".read": true,
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users": {
      "$userId": {
        ".read": true,
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users_by_permanent": {
      ".read": true,
      ".write": "auth != null"
    },

    "onlineUsers": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "poi_registry": {
      ".read": true,
      ".write": "auth != null"
    },

    "reports": {
      ".read":  false,
      ".write": "auth != null"
    },

    "bans": {
      ".read": true,
      ".write": "auth != null"
    },

    "payments": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    "_test_write": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    ".read":  false,
    ".write": false
  }
}
