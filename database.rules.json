{
  "rules": {
    "onlineUsers": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },

    "posts": {
      "$postId": {
        ".read": true,
        ".write": "(!data.exists() && newData.hasChild('zoneTag') && newData.child('zoneTag').isString() && !newData.child('zoneTag').val().matches('.*\\d+\\.\\d+.*')) || (data.exists() && newData.exists() && newData.child('zoneTag').val() === data.child('zoneTag').val()) || (data.exists() && !newData.exists())"
      }
    },

    "posts_by_zone": {
      "$zone": {
        "$postId": {
          ".read": true,
          ".write": "(!data.exists() && newData.hasChild('zoneTag') && newData.child('zoneTag').val() === $zone) || (data.exists() && newData.exists() && newData.child('zoneTag').val() === data.child('zoneTag').val() && newData.child('zoneTag').val() === $zone) || (data.exists() && !newData.exists())"
        }
      }
    },

    "post_events": {
      "removed": {
        ".read": true,
        "$postId": {
          ".write": true
        }
      }
    },

    "users": {
      "$uid": {
        ".read": true,
        ".write": true,

        "posts": {
          "$postId": {
            ".read": true,
            ".write": true
          }
        },

        "profile": {
          ".read": true,
          ".write": true
        },

        "stats": {
          ".read": true,
          ".write": true
        },

        "locationHistory": {
          ".read": true,
          ".write": true
        }
      }
    },

    ".read": false,
    ".write": false
  }
}
