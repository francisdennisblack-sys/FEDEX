{
  "rules": {

    // Default: deny by default, allow specific nodes below
    ".read": false,
    ".write": false,

    "posts": {
      ".read": true,
      "$postId": {
        // Allow writes from authenticated users.
        // Also allow anonymous *creates* from device-scoped clients (permanentDeviceId)
        // but prevent anonymous updates/deletes. This preserves client UX for
        // unauthenticated devices while reducing abuse surface.
        ".write": "auth != null || (!data.exists() && newData.exists() && newData.child('permanentUserId').isString() && newData.child('permanentUserId').val().matches('^device-') && newData.child('createdAt').isNumber())",
        // Basic validation to ensure required fields on create
        ".validate": "(!data.exists() && newData.exists()) ? (newData.hasChildren(['createdAt']) && newData.child('createdAt').isNumber()) : true"
      }
    },

    "posts_by_zone": {
      ".read": true,
      // writes should come from server-side or authenticated clients
      ".write": "auth != null"
    },

    "post_events": {
      ".read": true,
      // events are sensitive; require auth to write (or server-side functions)
      ".write": "auth != null"
    },

    "post-votes": {
      ".read": true,
      "$postId": {
        // Allow authenticated voting. Allow anonymous vote *creates* from
        // device-scoped clients (stored under a device key) but disallow
        // anonymous edits/deletes.
        "$voteId": {
          ".write": "auth != null || (!data.exists() && newData.exists() && newData.child('deviceId').isString() && newData.child('deviceId').val().matches('^device-'))"
        }
      }
    },

    "user-votes": {
      ".read": true,
      "$userId": {
        // Only the authenticated user may write to their own vote-tracking node.
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "user-posts": {
      ".read": true,
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users": {
      ".read": true,
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users_by_permanent": {
      ".read": true,
      ".write": "auth != null"
    },

    "onlineUsers": {
      ".read": true,
      ".write": "auth != null"
    },

    "poi_registry": {
      ".read": true,
      ".write": "auth != null"
    },

    "reports": {
      ".read": false,
      ".write": "auth != null"
    },

    "bans": {
      ".read": true,
      ".write": "auth != null"
    },

    "payments": {
      ".read": true,
      ".write": "auth != null"
    },

    "_test_write": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
