{
  "rules": {

    // Default: deny by default, allow specific nodes below
    ".read": false,
    ".write": false,

    "posts": {
      ".read": true,
      "$postId": {
        // Allow writes from authenticated users.
        // Also allow anonymous *creates* from device-scoped clients (permanentDeviceId)
        // but prevent anonymous updates/deletes. This preserves client UX for
        // unauthenticated devices while reducing abuse surface.
        // Allow authenticated writes OR anonymous create-only when the creator
        // supplies a stored `permanentUserId` (perm-...) or device id.
        // Also allow anonymous updates that only set numeric `likes`/`dislikes` so
        // the client-side vote transaction can persist aggregated counts.
        ".write": "auth != null || (!data.exists() && newData.exists() && newData.child('permanentUserId').isString() && newData.child('permanentUserId').val().matches(/^(perm-|device-|local-|device-local-)/) && newData.child('createdAt').isNumber()) || (data.exists() && newData.exists() && newData.child('likes').isNumber() && newData.child('dislikes').isNumber())",
        // Basic validation to ensure required fields on create. For updates that
        // modify counts, ensure likes/dislikes are numeric.
        ".validate": "(!data.exists() && newData.exists()) ? (newData.hasChildren(['createdAt']) && newData.child('createdAt').isNumber()) : ((data.exists() && newData.exists()) ? ((newData.child('likes').exists() && newData.child('likes').isNumber() && newData.child('dislikes').exists() && newData.child('dislikes').isNumber()) || true) : true)"
      }
    },

    "posts_by_zone": {
      ".read": true,
      // writes should come from server-side or authenticated clients
      ".write": "auth != null"
    },

    "post_events": {
      ".read": true,
      // events are sensitive; require auth to write (or server-side functions)
      ".write": "auth != null"
    },

    "post-votes": {
      ".read": true,
      "$postId": {
        // Allow authenticated voting.
        // Allow anonymous voting when the vote key is a device-scoped id (device-...)
        // The client writes votes as simple strings: 'like' or 'dislike' under
        // post-votes/{postId}/{voterId}: "like". Validate values accordingly.
        "$voteId": {
          ".write": "auth != null || $voteId.matches(/^(perm-|device-|local-|device-local-)/)",
          ".validate": "(!newData.exists()) || (newData.isString() && (newData.val() === 'like' || newData.val() === 'dislike'))"
        }
      }
    },

    "user-votes": {
      ".read": true,
      "$userId": {
        // Only the authenticated user may write to their own vote-tracking node.
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "user-posts": {
      ".read": true,
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users": {
      ".read": true,
      "$userId": {
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "users_by_permanent": {
      ".read": true,
      ".write": "auth != null"
    },

    "onlineUsers": {
      ".read": true,
      ".write": "auth != null"
    },

    "poi_registry": {
      ".read": true,
      ".write": "auth != null"
    },

    "reports": {
      ".read": false,
      ".write": "auth != null"
    },

    "bans": {
      ".read": true,
      ".write": "auth != null"
    },

    "payments": {
      ".read": true,
      ".write": "auth != null"
    },

    "_test_write": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
