<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Logo Test — Canvas Globe with Orbiting Text</title>
  <style>
    body { background:#06121a; color:#cfeee1; display:flex; height:100vh; align-items:center; justify-content:center; margin:0; }
    .header { height:72px; width:72px; position:relative; }
    canvas { display:block; }
    /* pulse & glow to mimic protected logo visuals */
    @keyframes brandPulse { 0% { transform: scale(0.55); } 50% { transform: scale(0.69); } 100% { transform: scale(0.55); } }
    @keyframes brandGlow { 0% { filter: drop-shadow(0 0 6px rgba(34,197,94,0.6)); } 50% { filter: drop-shadow(0 0 12px rgba(34,197,94,0.9)); } 100% { filter: drop-shadow(0 0 6px rgba(34,197,94,0.6)); } }
    #brandGlobeCanvas.online { animation: brandPulse 1.2s infinite, brandGlow 1.2s infinite; }
  </style>
</head>
<body>
  <div class="header">
    <canvas id="brandGlobeCanvas" width="72" height="72" style="width:72px;height:72px;transform:scale(0.55);" title="wificontent.com"></canvas>
  </div>

  <script>
    // Minimal isolated copy of the protected globe engine, adapted for testing
    window.brandGlobeEngine = (function() {
      const canvas = document.getElementById('brandGlobeCanvas');
      if (!canvas) return { start: () => {}, stop: () => {} };
      const ctx = canvas.getContext('2d');
      const radius = 20; // sphere radius in px (canvas is 72×72 here)
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;
      let rotation = 0;
      let animFrameId = null;
      let isRunning = false;

      const continents = [
        { lat: 45, lon: -100, size: 3 },
        { lat: -20, lon: -60, size: 2.5 },
        { lat: 50, lon: 10, size: 3.5 },
        { lat: 20, lon: 75, size: 4 },
        { lat: 35, lon: 105, size: 3.5 },
        { lat: -25, lon: 133, size: 3 }
      ];

      // Texts that will orbit around the globe
      const orbitTexts = [
        { text: 'Press here', offset: 0 },
        { text: 'Button', offset: 180 }
      ];

      function drawGlobe() {
        const w = canvas.width;
        const h = canvas.height;

        // Clear
        ctx.clearRect(0, 0, w, h);

        // Ocean
        ctx.fillStyle = '#0a1628';
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.fill();

        // Land masses
        ctx.fillStyle = '#22c55e';
        for (const cont of continents) {
          const lat = cont.lat * Math.PI / 180;
          const lon = (cont.lon + rotation) * Math.PI / 180;
          const cosLat = Math.cos(lat);
          const z = Math.cos(lon) * cosLat;
          if (z > 0) {
            const x = cx + radius * Math.sin(lon) * cosLat;
            const y = cy + radius * Math.sin(lat);
            ctx.beginPath();
            ctx.arc(x, y, cont.size, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        // Grid lines
        ctx.strokeStyle = 'rgba(34,197,94,0.18)';
        ctx.lineWidth = 0.5;
        for (let lat = -60; lat <= 60; lat += 30) {
          const latRad = lat * Math.PI / 180;
          ctx.beginPath();
          for (let lon = 0; lon <= 360; lon += 10) {
            const lonRad = (lon + rotation) * Math.PI / 180;
            const cosLat = Math.cos(latRad);
            const z = Math.cos(lonRad) * cosLat;
            if (z > 0) {
              const x = cx + radius * Math.sin(lonRad) * cosLat;
              const y = cy + radius * Math.sin(latRad);
              if (lon === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            }
          }
          ctx.stroke();
        }

        // Orbiting dots (small white dots) — mimic original behaviour
        ctx.fillStyle = '#cfeee1';
        for (let i = 0; i < 10; i++) {
          const ang = ((rotation + i * 36) % 360) * Math.PI / 180;
          const r = radius + 6;
          const x = cx + r * Math.cos(ang);
          const y = cy + r * Math.sin(ang);
          ctx.beginPath();
          ctx.arc(x, y, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }

        // Orbiting text — render just outside the orbiting dots and rotate with globe
        ctx.font = '7px Inter, Arial, sans-serif';
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (const t of orbitTexts) {
          const ang = ((rotation + t.offset) % 360) * Math.PI / 180;
          const r = radius + 12; // place text further out
          const x = cx + r * Math.cos(ang);
          const y = cy + r * Math.sin(ang);
          // Slight fade to match subtlety
          ctx.globalAlpha = 0.95;
          ctx.fillText(t.text, x, y);
          ctx.globalAlpha = 1;
        }
      }

      function animate() {
        if (!isRunning) return;
        rotation += 1.5; // keep same rotation speed
        if (rotation >= 360) rotation -= 360;
        drawGlobe();
        animFrameId = requestAnimationFrame(animate);
      }

      // Initial draw
      drawGlobe();

      return {
        start: () => { if (!isRunning) { isRunning = true; animate(); canvas.classList.add('online'); } },
        stop: () => { isRunning = false; if (animFrameId) cancelAnimationFrame(animFrameId); canvas.classList.remove('online'); drawGlobe(); }
      };
    })();

    // Auto-start for test page
    try { window.brandGlobeEngine.start(); } catch (e) { console.warn('start failed', e); }
  </script>
</body>
</html>
