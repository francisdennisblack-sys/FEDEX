rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public reads are allowed so images load in the feed.
    // Writes are restricted: only authenticated users may write into
    // the main `networks/.../photos/...` folder. A limited `public-uploads`
    // prefix is allowed for small, anonymous uploads (size limit enforced).
    match /networks/{network=**}/photos/{postId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Optional public upload area for anonymous uploads (small files only).
    match /public-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'));
    }

    // Default: disallow other writes, allow reads for other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
